# ─── Whale threshold (USD notional) ────────────────────────────────────────────
WHALE_THRESHOLD_USD=5000

# ─── Telegram (optional) ───────────────────────────────────────────────────────
# Create a bot via @BotFather, then send it any message and call
#   https://api.telegram.org/bot<TOKEN>/getUpdates  to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Interactive Telegram bot ──────────────────────────────────────────────────
# When enabled, the bot also long-polls Telegram for COMMANDS like /snap,
# /status, /bias. Only chat IDs in the allow-list below can issue commands;
# everyone else is silently ignored.
#
# Default allow-list = [TELEGRAM_CHAT_ID]. Add more (comma-separated) in
# TELEGRAM_AUTHORIZED_CHATS if you want a second device or someone you trust
# to be able to command the bot.
TG_COMMAND_BOT_ENABLED=true
TELEGRAM_AUTHORIZED_CHATS=

# Headless-Chromium screenshot service used by /snap. Disable to skip the
# Playwright install and never expose dashboard captures via Telegram.
TG_SNAPSHOT_ENABLED=true

# URL the screenshot service navigates to. Defaults to the local dashboard.
# Override only if you've put the dashboard behind a proxy / different host.
TG_DASHBOARD_URL=http://127.0.0.1:8787/

# If non-zero, the bot starts pushing a snapshot to every authorized chat
# at this interval automatically on startup (in minutes). Equivalent to
# typing `/auto on N` once. Set to 0 to disable.
TG_AUTO_SNAP_MIN=0

# ─── Snapshot performance ──────────────────────────────────────────────────────
# The screenshot service keeps one Chromium page warm and serves cached PNGs
# for blistering /snap latency. Tunables:
#
#   SNAP_SETTLE_MS         per-snap wait for live SSE/tick data to paint (250ms)
#   SNAP_CACHE_MAX_AGE_SEC serve cache when this fresh; 0 = always fresh shot
#   SNAP_AUTO_REFRESH_SEC  background re-snap cadence; 0 = no prewarm
#   SNAP_RELOAD_EVERY_SEC  full page reload on this cadence; protects vs drift
#
# Defaults: ~150 ms /snap latency including Telegram round trip. Lower
# SNAP_AUTO_REFRESH_SEC for ultra-fresh cache (more CPU); raise for less.
SNAP_SETTLE_MS=250
SNAP_CACHE_MAX_AGE_SEC=2.0
SNAP_AUTO_REFRESH_SEC=5.0
SNAP_RELOAD_EVERY_SEC=300

# ─── Telegram signal filter ────────────────────────────────────────────────────
# Console keeps showing every whale; these gate which events fire a Telegram
# push. All conditions are AND-ed together. Set TG_MIN_NOTIONAL_USD=0 and
# TG_MIN_WINRATE=0 and TG_ALLOWED_TIERS= (empty) to disable filtering.
#
# Tiers (computed from the wallet's closed-trade history):
#   ELITE    — ≥20 trades, ≥60% wr, ≥$1M PnL
#   TRUSTED  — ≥10 trades, ≥55% wr, positive PnL
#   MIXED    — passes the floor checks but isn't trusted
#   POOR     — <40% wr or <-$100K PnL (you'd want to fade these)
#   NEW      — <5 closed trades (not enough history)
#   UNKNOWN  — couldn't fetch a track record
TG_MIN_NOTIONAL_USD=400000
TG_MIN_WINRATE=0.61
TG_ALLOWED_TIERS=TRUSTED,ELITE

# Wallet watchlist — comma-separated addresses. Any event from one of these
# wallets bypasses ALL filters above and is pushed with a ⭐ WATCHED prefix.
# Use to follow specific traders you've vetted yourself.
TG_WATCH_WALLETS=

# Conviction-burst alerts: when N+ distinct ≥TRUSTED wallets open the same
# side on the same coin inside the window, fire a single 🔥 CONVICTION push.
# After firing for a (coin, side) the watcher waits the cooldown before
# re-alerting on the same pair.
CONVICTION_MIN_TRADERS=3
CONVICTION_WINDOW_MIN=30
CONVICTION_COOLDOWN_MIN=30

# Position lifecycle: when a TRUSTED+ wallet closes a position the bot
# previously alerted on, push a 🏁 EXIT alert with realized PnL & hold time.
# Set false to disable (e.g. if you don't intend to copy-trade and just want
# the entry signal).
LIFECYCLE_ALERTS_ENABLED=true

# ─── Active position polling ───────────────────────────────────────────────────
# Periodically calls Hyperliquid's clearinghouseState for the union of:
#   • TG_WATCH_WALLETS (always polled)
#   • TRUSTED+ wallets seen in events in the last 24h (auto-promoted)
# capped at POLL_MAX_WALLETS. Detects sub-threshold rebalances, pre-startup
# positions, partial closes — all things the trade tape can't show you.
# Diffs are published to the bus as POSITION_UPDATE events (filterable in the
# dashboard live feed under the "🔄 Poll" chip) and the "Live positions"
# panel surfaces the latest snapshot of every polled wallet's open book.
POLL_ENABLED=true
POLL_INTERVAL_SEC=30
POLL_MAX_WALLETS=40
POLL_MIN_CHANGE_USD=1000

# ─── Hyperliquid ───────────────────────────────────────────────────────────────
HL_ENABLED=true
# Comma-separated list of HL perp coins. Tip: pass --coins BTC,ETH,SOL on the CLI
# to override this for a single run (also overrides JUP_COINS).
HL_COINS=BTC,ETH,SOL,HYPE,XRP,DOGE,SUI,kPEPE
HL_WS_URL=wss://api.hyperliquid.xyz/ws
HL_INFO_URL=https://api.hyperliquid.xyz/info

# ─── Jupiter Perps (Solana) ────────────────────────────────────────────────────
JUP_ENABLED=true
# Subset of {SOL, ETH, BTC} — the only three perp custodies on Jupiter.
JUP_COINS=SOL,ETH,BTC
# In April 2025 Jupiter shipped `Instant*` instructions which DON'T emit
# Anchor `Program data:` events. The bot enriches those by fetching the full
# transaction via getTransaction and decoding the instruction data + accounts.
# Disable to fall back to the legacy log-only path (you'll miss most trades).
JUP_ENRICH_INSTANT=true
# Maximum concurrent getTransaction calls. Public RPC tolerates 4–8; private
# RPC (Helius/Triton) can go much higher.
JUP_ENRICH_CONCURRENCY=4
# Public RPC works but is rate-limited. Use Helius / Triton / QuickNode for production.
SOLANA_RPC_HTTP=https://api.mainnet-beta.solana.com
SOLANA_RPC_WS=wss://api.mainnet-beta.solana.com

# ─── Drift Protocol (Solana's largest perps DEX) ───────────────────────────────
# Pulls from Drift's public Data API at https://data.api.drift.trade/. No
# WebSocket required — REST polling is more reliable for whale detection.
DRIFT_ENABLED=true
# Empty = use the curated list of deepest perp markets. Comma-separated
# Drift symbols, e.g. SOL-PERP,BTC-PERP,ETH-PERP,HYPE-PERP.
DRIFT_MARKETS=
# Extra coin filter (matches the base ticker, post-1M/1K stripping). Leave
# empty to track every market.
DRIFT_COINS=
# Per-market refresh hint (seconds). Actual cadence is gated by DRIFT_MAX_RPS,
# so refresh ≈ markets_count / DRIFT_MAX_RPS regardless of this value.
DRIFT_POLL_SEC=10.0
# Page size per poll. 50 is plenty for whale-sized fills (<1% of all fills).
DRIFT_PAGE_SIZE=50
DRIFT_DATA_API=https://data.api.drift.trade
# Global request budget for the Drift Data API. 1 RPS is the empirical safe
# ceiling — going hotter (3+ RPS) gets the IP shadow-banned with HTTP 403 for
# 5+ minutes. With a private proxy you can safely raise this to 5–10.
DRIFT_MAX_RPS=1.0

# ─── CEX in/out flows (Solana) ─────────────────────────────────────────────────
# Subscribes to logsSubscribe for every curated CEX hot wallet (see
# cex_wallets.CEX_WALLETS — Binance, Coinbase, OKX, Bybit, Kraken, KuCoin,
# Bitfinex, MEXC, Gate, Crypto.com, Robinhood, Bitget, HTX) and decodes
# each on-chain transfer that touches one of them into a structured
# IN (deposit, bearish) / OUT (withdraw, bullish) event. Net flow is
# computed in real time and exposed at /api/cex-flows + on the dashboard
# panel ("CEX flows" card).
#
# IMPORTANT: each logsNotification triggers a getTransaction call. The
# public Solana RPC throttles aggressively, so on a free endpoint expect
# many "tx_fetch_failed" entries in the heartbeat. For full coverage,
# point SOLANA_RPC_HTTP / SOLANA_RPC_WS at a paid endpoint (Helius,
# Triton, QuickNode) and bump CEX_MAX_CONCURRENT_ENRICH to 12+.
CEX_FLOWS_ENABLED=true
# Skip transfers smaller than this in USD.
CEX_MIN_FLOW_USD=5000
# Max concurrent getTransaction calls (raise on a paid RPC).
CEX_MAX_CONCURRENT_ENRICH=6
# Single-transfer Telegram alert threshold; 0 disables alerts.
CEX_ALERT_MIN_USD=0

# ─── Bot vs human classification ───────────────────────────────────────────────
# Each whale's actor label is derived from their closed-trade history:
#   trades_per_day  =  closed_trades / days_active
#   ≥ BOT_TPD_THRESHOLD     → BOT     (HFT / scalper / market-maker)
#   ≥ HYBRID_TPD_THRESHOLD  → HYBRID  (active manual or supervised bot)
#   <                       → HUMAN
#   < ACTOR_MIN_SAMPLES closed trades → UNKNOWN (not enough data)
BOT_TPD_THRESHOLD=30
HYBRID_TPD_THRESHOLD=5
ACTOR_MIN_SAMPLES=10

# ─── Web dashboard ─────────────────────────────────────────────────────────────
WEB_ENABLED=true
WEB_HOST=127.0.0.1
WEB_PORT=8787
MONGO_ENABLED=true
MONGO_URI=mongodb://localhost:27017
MONGO_DB=perps_whales
MONGO_COLLECTION=events

# ─── Behavior ──────────────────────────────────────────────────────────────────
# Skip alerts that we can't price (defensive default).
DROP_UNPRICED=true
